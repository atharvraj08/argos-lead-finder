# Argos Lead Finder environment variables.
# Copy to .env for local runs (.env is gitignored). In GitHub Actions, set each
# of these as a repository secret (Settings > Secrets and variables > Actions).

# Anthropic API key for LLM extraction and web search (required).
ANTHROPIC_API_KEY=

# SeatGeek API client ID for event discovery (https://seatgeek.com/account/develop).
SEATGEEK_CLIENT_ID=

# Google service account with edit access to the leads Sheet. Use ONE of:
#   GOOGLE_SERVICE_ACCOUNT_JSON: the full JSON key contents (used in GitHub Actions)
#   GOOGLE_APPLICATION_CREDENTIALS: path to the JSON key file (handy locally)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
# ID of the Google Sheet (the long string in its URL between /d/ and /edit).
GOOGLE_SHEET_ID=

# Email, method chosen in config/email.yaml.
# gmail_smtp: Gmail address and a 16-character App Password (requires 2-Step Verification).
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
# resend: API key and a verified sender, e.g. "Argos Leads <leads@yourdomain.com>".
RESEND_API_KEY=
RESEND_FROM=
